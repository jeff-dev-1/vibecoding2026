# 拷贝为 .env 后编辑

# === 镜像仓库 (仅 docker-compose.dist.yml 学生发行版用) ===
# 阿里云 ACR 个人版 (cn-shanghai); 公开仓免登录直接拉。
IMAGE_REGISTRY=crpi-wl9py5zi0809kanh.cn-shanghai.personal.cr.aliyuncs.com/vibecoding-2026
IMAGE_TAG=latest

# === DeepSeek (默认上游) ===
# 每人自带 key: 去 https://platform.deepseek.com 注册后填到这里。
# 暂时没拿到 key? 先用 mock 兜底跑起来看界面:
#   docker compose -f docker-compose.dist.yml --profile mock up -d
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat
# backend 默认值; ChatRequest.backend 可单请求覆盖
LLM_BACKEND=deepseek

# === Qwen (DashScope, 第二上游, X-LLM-Backend: qwen 路由) ===
QWEN_API_KEY=

# === 网关 provider 切换 (envoy 默认 / portkey 可选) ===
# portkey: docker compose --profile portkey up -d gateway-portkey, 再设 GATEWAY_PROVIDER=portkey 重启 backend
GATEWAY_PROVIDER=envoy
# PORTKEY_URL=http://gateway-portkey:8787

# Demo gateway 鉴权 key (前端→gateway 的 demo bearer; 不是模型 key)
LLM_GATEWAY_API_KEY=demo-key-not-secret

# === 登录门 (前端) ===
DEMO_USERNAME=admin
DEMO_PASSWORD=vibecoding2026

# === Koi 供应链网关 (Pattern A; 真 SaaS via API) ===
# KOI_ENABLED=false → 走离线兜底 (modelscan / MCP allowlist), 不调外部 API
# 真实 token 填进 .env (已 gitignore), 切勿提交; .env.example 永远留空
KOI_ENABLED=false
KOI_API_BASE=https://api.prod.koi.security/api/external/v2
KOI_API_KEY=
# 鉴权头形式: bearer (Authorization: Bearer xxx) 或 header (x-api-key: xxx)
KOI_AUTH_STYLE=bearer

# === 离线兜底 (DEMO RUNBOOK 页) ===
# docker compose --profile mock up -d  → 加载 mock-llm container
# 然后改 envoy-ai-gateway 的 ENVOY_TEMPLATE 指向 envoy.yaml (mock 上游)

# === 其他上游 (要改 gateway/envoy-ai-gateway/config/envoy-deepseek.yaml.tmpl cluster) ===
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# === Observability (默认关) ===
# docker compose --profile observability up -d
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
