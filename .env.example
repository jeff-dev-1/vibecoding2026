# 拷贝为 .env 后编辑

# === DeepSeek (默认上游) ===
# 必填; 留空 gateway 会 401
DEEPSEEK_API_KEY=

# 默认模型 (deepseek-chat 或 deepseek-reasoner)
LLM_MODEL=deepseek-chat

# Demo gateway 鉴权 key (前端→gateway 的 demo bearer; 不是密钥)
LLM_GATEWAY_API_KEY=demo-key-not-secret

# === 切到其他上游 ===
# 切回 mock-llm (离线兜底, PPT Slide 39):
#   docker compose --profile mock up -d
#   并把 envoy-ai-gateway 的 envoy-deepseek.yaml.tmpl 换成 envoy.yaml (mock 上游)

# OpenAI (需要改 gateway 上游为 api.openai.com):
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Anthropic (Envoy AI Gateway 路由可切到 anthropic):
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001

# === Observability (默认关) ===
# 启用 OTel Collector:
#   docker compose --profile observability up -d
# 并设置:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
